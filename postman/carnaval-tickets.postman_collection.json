        {
          "name": "Pagar dos veces la misma reserva",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reservas/{{reservaId}}/pago",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valorEnPesos\": 240000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pregunta para la clase: PagarReservaService llama a la pasarela ANTES de que confirmarPago detecte que ya estaba pagada. ¿Se cobró dos veces? En memoria sí (pasarela falsa). Con Pagos remoto (Sesión 3) la llave de idempotencia lo evita."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La segunda vez la regla lo impide (422)\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]

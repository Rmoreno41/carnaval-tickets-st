    {
      "name": "06-eventos · Sesión 4",
      "description": "Rama 06. Usa la API HTTP de la consola de RabbitMQ (usuario guest/guest) para publicar mensajes a mano en la cola notificaciones.pedidos. Mira la consola de notificaciones-servicio mientras envías.",
      "item": [
        {
          "name": "Pagar (publica PedidoConfirmado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reservas/{{reservaId}}/pago",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valorEnPesos\": 240000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Con perfiles postgres,pagos-remoto,rabbit. Luego revisa las colas."
          }
        },
        {
          "name": "Ver estado de las colas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitUrl}}/api/queues",
            "description": "Abre la consola de Postman (View → Show Postman Console) para ver el resumen.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "guest",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "guest",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const colas = pm.response.json().map(c => `${c.name}: listos=${c.messages_ready} consumidores=${c.consumers}`);",
                  "console.log(colas.join(\"\\n\"));",
                  "pm.test(\"Hay colas declaradas\", () => pm.expect(colas.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Experimento 3 · Evento (enviar dos veces)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbitUrl}}/api/exchanges/%2F/amq.default/publish",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"content_type\": \"application/json\"\n  },\n  \"routing_key\": \"notificaciones.pedidos\",\n  \"payload\": \"{\\\"eventId\\\": \\\"e-1\\\", \\\"correlationId\\\": \\\"c-1\\\", \\\"reservaId\\\": \\\"r-1\\\", \\\"documento\\\": \\\"1085\\\", \\\"cantidad\\\": 2}\",\n  \"payload_encoding\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Envíalo dos veces: debe aparecer un CORREO y luego DUPLICADO ignorado e-1.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "guest",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "guest",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"RabbitMQ lo enrutó a una cola\", () => pm.expect(pm.response.json().routed).to.eql(true));"
                ]
              }
            }
          ]
        },

    {
      "name": "05-pagos-servicio · Sesión 3",
      "description": "Rama 05. Pagos corre aparte en el puerto 8081. Ejecuta primero 'Reservar 2 boletas' de la carpeta anterior.",
      "item": [
        {
          "name": "Cobrar directo en Pagos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{llave}}"
              }
            ],
            "url": "{{pagosUrl}}/cobros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": \"{{llave}}\",\n  \"documento\": \"1085\",\n  \"valorEnPesos\": 240000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"referencia\", pm.response.json().referencia);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir el mismo cobro (idempotencia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{llave}}"
              }
            ],
            "url": "{{pagosUrl}}/cobros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": \"{{llave}}\",\n  \"documento\": \"1085\",\n  \"valorEnPesos\": 240000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Misma referencia: no cobró dos veces\", () =>",
                  "  pm.expect(pm.response.json().referencia).to.eql(pm.collectionVariables.get(\"referencia\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cobro sin llave",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{pagosUrl}}/cobros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": \"r-sin-llave\",\n  \"documento\": \"1085\",\n  \"valorEnPesos\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400: la llave es parte del contrato\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagar reserva a través del monolito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reservas/{{reservaId}}/pago",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valorEnPesos\": 240000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Con perfil pagos-remoto. Con DEMORA_MS=5000 y timeout de 2 s debe responder 503 a los 2 segundos."
          }
        }

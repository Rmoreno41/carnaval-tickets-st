    {
      "name": "02 a 04 · Hexagonal · Sesión 2",
      "description": "Ramas 03-adaptadores y 04-archunit. Las mismas peticiones deben dar lo mismo con el perfil memoria y con el perfil postgres: esa es la demostración.",
      "item": [
        {
          "name": "Reservar 2 boletas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reservas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentoComprador\": \"1085\",\n  \"localidadId\": \"palco-6ene\",\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().reservaId;",
                  "pm.test(\"Trae reservaId\", () => pm.expect(id).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"reservaId\", id); // la usa \"Pagar la reserva\""
                ]
              }
            }
          ]
        },

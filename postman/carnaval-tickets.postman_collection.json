              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// En el barro, un error de negocio responde 200. El cliente tiene que leer el cuerpo para saber que falló.",
                  "pm.test(\"Responde 200 aunque sea un error (defecto del barro)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El cuerpo dice el error\", () => pm.expect(pm.response.json().error).to.eql(\"maximo 6 boletas\"));"
                ]

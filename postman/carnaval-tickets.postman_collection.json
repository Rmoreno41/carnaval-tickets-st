  "item": [
    {
      "name": "00-barro · Sesión 1",
      "description": "Rama 00-barro. Todo pasa por PedidoController. Fíjate: los errores responden 200 con {\"error\": ...}. Es parte del barro.",
      "item": [
        {
          "name": "Listar localidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/localidades"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae las 3 localidades del Carnaval\", () => pm.expect(pm.response.json().length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprar 2 boletas (estudiante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"1085\",\n  \"localidadId\": \"palco-6ene\",\n  \"cantidad\": 2,\n  \"tarjeta\": \"4111\",\n  \"estudiante\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Total con 20% de descuento: 192000\", () => pm.expect(pm.response.json().total).to.eql(192000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Comprar 7 boletas (regla del 6)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"1085\",\n  \"localidadId\": \"palco-6ene\",\n  \"cantidad\": 7,\n  \"tarjeta\": \"4111\"\n}",
              "options": {
